{
  "name": "my-windows-app",
  "productName": "my-windows-app",
  "version": "1.0.0",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Rely Ky",
    "email": "relyky@hotmail.com"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "echo \"No linting configured\"",
    "postinstall": "npx --no-install install-electron && winapp restore && winapp node add-electron-debug-identity"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.24",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.24",
    "@microsoft/winappcli": "^0.8.0",
    "electron": "45.3.4"
  },
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [],
      "additionalRefs": []
    }
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "import": "./.winapp/bindings/index.mjs",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    },
    "#winapp/bindings/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "default": "./.winapp/bindings/*.js"
    }
  }
}
